  "scripts": {
    "dev": "vite",
    "dev:local": "concurrently \"vite\" \"npx tsx server/local.ts\"",
    "server": "npx tsx server/local.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "turbo:build": "turbo run build",
    "turbo:lint": "turbo run lint",
    "turbo:typecheck": "turbo run typecheck",
    "smoke:triangle": "tsx scripts/triangle-smoke.ts",
    "smoke:vision": "tsx scripts/vision-broker-smoke.ts",
    "seed:prospects": "tsx scripts/seed-prospects.ts",
    "env:audit": "tsx scripts/env-audit.ts",
    "env:audit:prod": "tsx scripts/env-audit.ts --check-vercel",
    "prepare": "husky"
  },
