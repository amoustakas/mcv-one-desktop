{
  "name": "@mcv/core-triangle",
  "version": "0.1.0",
  "description": "Typed HTTP clients for the MCV Core Triangle microservices — Identity (8080), Fabric (8081), Intelligence (8082). Ships with graceful-degradation semantics: every method returns CoreResponse<T> so callers fall back cleanly when a service is unreachable.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./identity": { "types": "./src/identity.ts", "default": "./src/identity.ts" },
    "./fabric":   { "types": "./src/fabric.ts",   "default": "./src/fabric.ts" },
    "./intelligence": { "types": "./src/intelligence.ts", "default": "./src/intelligence.ts" },
    "./types":    { "types": "./src/types.ts",    "default": "./src/types.ts" }
  },
  "files": ["src"],
  "scripts": {
    "lint": "echo 'no lint yet'",
    "test": "echo 'no tests yet'"
  }
}
