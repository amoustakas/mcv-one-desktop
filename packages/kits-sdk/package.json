{
  "name": "@mcv/kits-sdk",
  "version": "0.10.0",
  "description": "MCV Agent-First Kit primitives — types, capability-based permissions, Web Worker sandbox, runtime bridge, registry client, shared key-value context. The portable substrate of the MCV orchestration shell. Loader, orchestrator and notifications stay in the app shell until their DI boundaries are established.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":                 { "types": "./src/index.ts",                "default": "./src/index.ts" },
    "./types":           { "types": "./src/types.ts",                "default": "./src/types.ts" },
    "./sandbox":         { "types": "./src/sandbox.ts",              "default": "./src/sandbox.ts" },
    "./permissions":     { "types": "./src/permissions.ts",          "default": "./src/permissions.ts" },
    "./bridge":          { "types": "./src/bridge.ts",               "default": "./src/bridge.ts" },
    "./shared-context":  { "types": "./src/shared-context.ts",       "default": "./src/shared-context.ts" },
    "./registry-client": { "types": "./src/registry-client.ts",      "default": "./src/registry-client.ts" },
    "./loader":          { "types": "./src/loader.ts",               "default": "./src/loader.ts" },
    "./orchestrator":    { "types": "./src/orchestrator.ts",         "default": "./src/orchestrator.ts" },
    "./autonomous-agent":{ "types": "./src/autonomous-agent.ts",     "default": "./src/autonomous-agent.ts" },
    "./builtin/*":       { "types": "./src/builtin/*.ts",            "default": "./src/builtin/*.ts" }
  },
  "files": ["src"],
  "dependencies": {
    "@mcv/ad-specs-sdk": "*",
    "@mcv/capital-sdk": "*",
    "@mcv/mcp-sdk": "*",
    "@mcv/payments-sdk": "*",
    "@mcv/storage-sdk": "*",
    "@mcv/ventures-sdk": "*"
  },
  "scripts": {
    "lint": "echo 'no lint yet'",
    "test": "echo 'no tests yet'"
  }
}
