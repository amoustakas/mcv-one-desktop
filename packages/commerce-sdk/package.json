{
  "name": "@mcv/commerce-sdk",
  "version": "0.7.0",
  "description": "MCV Commerce & Financial OS — types + (progressively) service factories. First slice ships the canonical type system (products, orders, subscriptions, invoices, loans, fulfillment, discounts, inventory, gift cards, reviews, wishlists, search, analytics). Service engines will land as incremental DI factories composed on @mcv/ledger-sdk + @mcv/payments-sdk.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":               { "types": "./src/index.ts",          "default": "./src/index.ts" },
    "./types":         { "types": "./src/types.ts",          "default": "./src/types.ts" },
    "./surface-types": { "types": "./src/surface-types.ts",  "default": "./src/surface-types.ts" },
    "./search-engine": { "types": "./src/search-engine.ts",  "default": "./src/search-engine.ts" },
    "./wishlist-service": { "types": "./src/wishlist-service.ts", "default": "./src/wishlist-service.ts" },
    "./review-service": { "types": "./src/review-service.ts", "default": "./src/review-service.ts" },
    "./notification-service": { "types": "./src/notification-service.ts", "default": "./src/notification-service.ts" },
    "./digital-delivery-service": { "types": "./src/digital-delivery-service.ts", "default": "./src/digital-delivery-service.ts" },
    "./commerce-analytics": { "types": "./src/commerce-analytics.ts", "default": "./src/commerce-analytics.ts" }
  },
  "files": ["src"],
  "dependencies": {
    "nanoid": "^5.1.7",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "scripts": {
    "lint": "echo 'no lint yet'",
    "test": "echo 'no tests yet'"
  }
}
