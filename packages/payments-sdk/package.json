{
  "name": "@mcv/payments-sdk",
  "version": "0.2.0",
  "description": "MCV unified payment rails — router, 4 processors (Stripe, Plaid ACH, Solana Pay, Platform Credits), and split-engine. Smart routing by cost/speed/reliability/compliance. Split-engine uses DI factory (caller injects Supabase + LedgerAdapter) so any venture's ledger can plug in.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./router": { "types": "./src/router.ts", "default": "./src/router.ts" },
    "./types": { "types": "./src/types.ts", "default": "./src/types.ts" },
    "./split-engine": { "types": "./src/split-engine.ts", "default": "./src/split-engine.ts" },
    "./processors/stripe": { "types": "./src/processors/stripe.ts", "default": "./src/processors/stripe.ts" },
    "./processors/plaid": { "types": "./src/processors/plaid.ts", "default": "./src/processors/plaid.ts" },
    "./processors/solana": { "types": "./src/processors/solana.ts", "default": "./src/processors/solana.ts" }
  },
  "files": ["src"],
  "dependencies": {
    "@solana/pay": "^0.2.6",
    "@solana/web3.js": "^1.98.4",
    "bignumber.js": "^10.0.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "scripts": {
    "lint": "echo 'no lint yet'",
    "test": "echo 'no tests yet'"
  }
}
