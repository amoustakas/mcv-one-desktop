{
  "name": "@mcv/signer-sdk",
  "version": "0.1.0",
  "description": "MCV Agentic OS — venture-agnostic, role-agnostic, agent-friendly electronic-signing primitive. Ships as a cross-framework SDK (core / react / next / server / events / registry) so every MCV venture + child-venture consumes signing with ~20 LOC of glue. Built for mass expansion: N documents per envelope, agent-generated origin, child-venture tenancy, template-versioning, cross-tree audit rollup, 5 event topics from day 1.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".":                            { "types": "./src/index.ts",                           "default": "./src/index.ts" },
    "./core":                       { "types": "./src/core/index.ts",                      "default": "./src/core/index.ts" },
    "./core/types":                 { "types": "./src/core/types.ts",                      "default": "./src/core/types.ts" },
    "./core/errors":                { "types": "./src/core/errors.ts",                     "default": "./src/core/errors.ts" },
    "./core/esign-consent":         { "types": "./src/core/esign-consent.ts",              "default": "./src/core/esign-consent.ts" },
    "./core/token-verify":          { "types": "./src/core/token-verify.ts",               "default": "./src/core/token-verify.ts" },
    "./core/envelope-schema":       { "types": "./src/core/envelope-schema.ts",            "default": "./src/core/envelope-schema.ts" },
    "./core/tenancy":               { "types": "./src/core/tenancy.ts",                    "default": "./src/core/tenancy.ts" },
    "./core/server-client":         { "types": "./src/core/server-client.ts",              "default": "./src/core/server-client.ts" },
    "./react":                      { "types": "./src/react/index.ts",                     "default": "./src/react/index.ts" },
    "./next":                       { "types": "./src/next/index.ts",                      "default": "./src/next/index.ts" },
    "./server":                     { "types": "./src/server/index.ts",                    "default": "./src/server/index.ts" },
    "./events":                     { "types": "./src/events/index.ts",                    "default": "./src/events/index.ts" },
    "./events/contracts":           { "types": "./src/events/contracts.ts",                "default": "./src/events/contracts.ts" },
    "./registry":                   { "types": "./src/registry/index.ts",                  "default": "./src/registry/index.ts" },
    "./v0-2-hooks/jurisdiction":    { "types": "./src/v0-2-hooks/jurisdiction.ts",         "default": "./src/v0-2-hooks/jurisdiction.ts" },
    "./v0-2-hooks/attestation":     { "types": "./src/v0-2-hooks/attestation.ts",          "default": "./src/v0-2-hooks/attestation.ts" }
  },
  "files": ["src"],
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@mcv/events-sdk": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "scripts": {
    "lint": "echo 'no lint yet'",
    "test": "echo 'no tests yet'"
  }
}
