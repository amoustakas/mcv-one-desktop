.superpowers/

# Parallel-session scratch + debug artifacts — each produces thousands of files
# that VS Code would otherwise index as "untracked" and balloon the change count.
# Content is still on disk; just not in git or VS Code's source control view.
.tmp.driveupload/
.playwright-mcp/

