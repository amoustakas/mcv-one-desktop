# MCV One Desktop — Environment Variables
# Copy to .env.local and fill in your keys
# Server-side vars (no VITE_ prefix) are only available in api/ endpoints
# Client-side vars (VITE_ prefix) are bundled into the frontend

# ── Core AI ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=               # Claude API (required for chat)
GOOGLE_AI_KEY=                   # Gemini Pro / Flash
GOOGLE_MAPS_KEY=                 # Google Places + Geocoding

# ── Auth ─────────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=      # Clerk frontend auth
CLERK_SECRET_KEY=                # Clerk server-side JWT verification

# ── Database ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=               # Supabase project URL
VITE_SUPABASE_ANON_KEY=          # Supabase anonymous key (frontend)
SUPABASE_SERVICE_KEY=            # Supabase service role key (server)

# ── Integrations (API key fallbacks) ─────────────────────────────
GITHUB_TOKEN=                    # GitHub PAT (fallback if OAuth not connected)
VERCEL_TOKEN=                    # Vercel API token
NOTION_API_KEY=                  # Notion integration token (fallback)

# ── OAuth Providers ──────────────────────────────────────────────
# Create OAuth apps at each provider's developer console.
# Callback URL: https://your-domain.vercel.app/api/oauth/callback
GITHUB_OAUTH_CLIENT_ID=          # GitHub OAuth App → Settings > Developer settings
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=          # Google Cloud Console → Credentials
GOOGLE_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=          # Notion → My Integrations → Public integration
NOTION_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_CLIENT_ID=      # Cloudflare Dashboard → API Tokens
CLOUDFLARE_OAUTH_CLIENT_SECRET=
STRIPE_CLIENT_ID=                # Stripe Connect → Dashboard > Settings
STRIPE_SECRET_KEY=               # Stripe Dashboard → API Keys
SLACK_CLIENT_ID=                 # Slack API → Your Apps → OAuth
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=               # Discord Developer Portal → Applications
DISCORD_CLIENT_SECRET=
LINEAR_CLIENT_ID=                # Linear → Settings → API → OAuth Applications
LINEAR_CLIENT_SECRET=
FIGMA_CLIENT_ID=                 # Figma → Developer settings → My apps
FIGMA_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=              # LinkedIn → Developer Portal → My Apps
LINKEDIN_CLIENT_SECRET=
TWITCH_CLIENT_ID=                # Twitch → Developer Console → Applications
TWITCH_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=             # Azure Portal → App registrations → New registration
MICROSOFT_CLIENT_SECRET=         # Azure Portal → Certificates & secrets

# ── Social Media (API keys) ─────────────────────────────────────
TWITTER_BEARER_TOKEN=            # X Developer Portal → Bearer Token (app-only)

# ── OAuth Token Encryption ───────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=            # 64-char hex string (AES-256-GCM)

# ── Voice & Audio ────────────────────────────────────────────────
DEEPGRAM_API_KEY=                # Deepgram STT (Nova-2, Whisper, Aura TTS)
ELEVENLABS_API_KEY=              # ElevenLabs TTS, voice cloning, sound effects
VAPI_API_KEY=                    # Vapi AI voice assistants + outbound calls

# ── Cloudflare ───────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=            # Cloudflare API token (Workers, KV, R2, D1)
CLOUDFLARE_ACCOUNT_ID=           # Cloudflare account ID

# ── Workflow Automation ──────────────────────────────────────────
N8N_BASE_URL=                    # n8n instance URL (e.g. https://n8n.mcv.one)
N8N_API_KEY=                     # n8n API key

# ── Communications ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=              # Twilio Console → Account SID
TWILIO_AUTH_TOKEN=               # Twilio Console → Auth Token
TWILIO_PHONE_NUMBER=             # Twilio sender phone number (+1...)
TWILIO_VERIFY_SID=               # Twilio Verify Service SID
SENDGRID_API_KEY=                # SendGrid → Settings → API Keys
RESEND_API_KEY=                  # Resend Dashboard → API Keys

# ── Messaging Platforms ─────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=           # Meta Business Suite → WhatsApp API token
WHATSAPP_PHONE_NUMBER_ID=        # WhatsApp phone number ID
WHATSAPP_BUSINESS_ACCOUNT_ID=    # WhatsApp Business Account ID
MESSENGER_PAGE_TOKEN=            # Facebook Page token for Messenger
TELEGRAM_BOT_TOKEN=              # Telegram @BotFather → /newbot token
DISCORD_BOT_TOKEN=               # Discord Developer Portal → Bot token

# ── Finance ─────────────────────────────────────────────────────
PLAID_CLIENT_ID=                 # Plaid Dashboard → Keys
PLAID_SECRET=                    # Plaid Dashboard → Sandbox/Development/Production key
PLAID_ENV=sandbox                # sandbox | development | production
PLAID_WEBHOOK_VERIFY=1           # 0 to skip ES256 JWT verify in dev (default: 1)
STRIPE_SECRET_KEY=               # Stripe Dashboard → Developers → API keys
STRIPE_CLIENT_ID=                # Stripe Connect client_id (Connect-specific OAuth)
STRIPE_WEBHOOK_SECRET=           # Stripe Dashboard → Webhooks → signing secret (whsec_...)
                                 # Required for /api/stripe-webhook to verify + emit payment_events

# ── Additional AI ───────────────────────────────────────────────
OPENAI_API_KEY=                  # OpenAI → API Keys (GPT-4, DALL-E, Whisper)
LMSTUDIO_BASE_URL=http://localhost:1234  # LM Studio local server (default port)

# ── Advertising Platforms ────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=      # Google Ads API → Developer Token
GOOGLE_ADS_CUSTOMER_ID=          # Google Ads → Account ID (xxx-xxx-xxxx)
MICROSOFT_ADS_DEVELOPER_TOKEN=   # Microsoft Advertising → Developer Token
MICROSOFT_ADS_ACCOUNT_ID=        # Bing Ads → Account ID
MICROSOFT_ADS_CUSTOMER_ID=       # Bing Ads → Customer ID
META_AD_ACCOUNT_ID=              # Meta Ads → Ad Account ID (numeric)
TIKTOK_ACCESS_TOKEN=             # TikTok Business → Access Token
TIKTOK_ADVERTISER_ID=            # TikTok Ads → Advertiser ID

# ── Search APIs ─────────────────────────────────────────────────
BING_SEARCH_KEY=                 # Azure Portal → Bing Search v7 resource key

# ── Monitoring ──────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=               # Sentry → Settings → API → Auth Tokens
SENTRY_ORG_SLUG=                 # Sentry → Organization Settings → Slug

# Sentry
VITE_SENTRY_DSN=
VITE_VERCEL_GIT_COMMIT_SHA=
SENTRY_DSN=

# ── Scheduling ──────────────────────────────────────────────────
CALENDLY_API_KEY=                # Calendly → Integrations → API Key

# ── CRM ─────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=            # HubSpot → Settings → Integrations → Private Apps

# ── Infrastructure ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=          # Upstash Console → Redis Database
UPSTASH_REDIS_REST_TOKEN=        # Upstash Console → REST API Token

# ── Ventures ─────────────────────────────────────────────────────
FUTURESTATE_API_URL=             # FutureState RWA API (optional)

# ── Cron / Automation ───────────────────────────────────────────
# Shared secret sent as Authorization: Bearer <CRON_SECRET> by Vercel Cron
# so cron hits bypass Clerk auth. Used by:
#   /api/compliance-cron         (hourly dunning sweep)
#   /api/cron-asset-rediscovery  (daily 06:00 UTC)
#   /api/venture-docs-embed      (every 30m, RAG sync)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=                     # 64-char hex — same value in Vercel dashboard

# ── App ──────────────────────────────────────────────────────────
VITE_APP_ENV=development

# ── MCV Core Triangle (Identity / Fabric / Intelligence) ────────
# Browser-facing base URLs read by useCoreTriangle() in src/hooks/use-core-triangle.ts.
# Leave unset to fall back to Clerk + Supabase + direct Anthropic/Gemini SDKs.
VITE_MCV_CORE_IDENTITY_URL=          # e.g. http://localhost:7001 (Identity service)
VITE_MCV_CORE_FABRIC_URL=            # e.g. http://localhost:7002 (Fabric service)
VITE_MCV_CORE_INTELLIGENCE_URL=      # e.g. http://localhost:7003 (Intelligence gateway)

# Server-side Triangle URLs read by api/_handlers/* (Vercel functions / local Express).
# Same target services, no VITE_ prefix so they're hidden from the browser bundle.
IDENTITY_URL=                        # Identity service base URL (S2S calls)
FABRIC_URL=                          # Fabric service base URL (audit, events, jobs)
INTELLIGENCE_URL=                    # Intelligence gateway base URL (Claude/Gemini/etc routed here)
INTERNAL_SERVICE_SECRET=             # Shared secret for Triangle internal endpoints (X-Internal-Secret header)
